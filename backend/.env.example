# MySQL 8 database dedicated to this admin application.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/indian_jewellery"
PORT=5000
ADMIN_SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Used only by npm run admin:create. Remove ADMIN_PASSWORD after provisioning.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Store Administrator"
ADMIN_PASSWORD="replace-with-a-unique-password"
