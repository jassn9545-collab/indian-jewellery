// Prisma schema — PostgreSQL
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(150)
  email        String    @unique @db.VarChar(255)
  password     String    @db.VarChar(255)
  number       String    @default("") @db.VarChar(20)
  dob          String?   @db.VarChar(30)
  country      String?   @db.VarChar(100)

  /// 0 = in-active, 1 = active  (see USER_STATUS in src/config/constants.ts)
  status       Int       @default(1) @db.SmallInt
  /// 1 = admin, 2 = user  (see USER_TYPE in src/config/constants.ts)
  type         Int       @default(2) @db.SmallInt

  linkHash     Int?
  /// 0 = not verified, 1 = verified
  isVerified   Int       @default(0) @db.SmallInt
  /// 0 = not subscribed, 1 = subscribed
  isSubscribed Int       @default(0) @db.SmallInt

  refreshToken String?
  isDeleted    Boolean   @default(false)

  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([number])
  @@index([isDeleted])
  @@map("users")
}
