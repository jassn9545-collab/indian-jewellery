{
  "name": "node-ts-2025",
  "version": "1.0.0",
  "description": "",
  "main": "dist/app.js",
  "scripts": {
    "start": "npm run build \u0026\u0026 node dist/app.js",
    "lint": "eslint . --fix . --ext .ts",
    "build": "prisma generate --schema prisma/mysql/schema.prisma \u0026\u0026 tsc",
    "dev": "nodemon --exec ts-node src/app.ts",
    "seeder": "ts-node src/migrations/index",
    "prisma:generate": "prisma generate --schema prisma/mysql/schema.prisma",
    "migrate": "prisma migrate dev --schema prisma/mysql/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/mysql/schema.prisma",
    "db:push": "prisma db push --schema prisma/mysql/schema.prisma",
    "studio": "prisma studio --schema prisma/mysql/schema.prisma",
    "postinstall": "prisma generate --schema prisma/mysql/schema.prisma",
    "test": "echo \"Error: no test specified\" \u0026\u0026 exit 1",
    "admin:create": "ts-node src/admin/create-admin.ts"
  },
  "keywords": [],
  "author": "Suraj Yadav",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.17.1",
    "helmet": "^7.2.0",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.5.45",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "nodemailer-express-handlebars": "^6.1.2",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "prisma": "6.19.3"
  }
}
